VITE_API_BASE_URL=http://localhost:8000/api/v1
# true   = everything uses local mock data (no backend needed)
# hybrid = real backend for auth, chefs, search, availability and admin approval (Phases 1-3);
#          mock data for bookings, reviews, messages, favourites and AI (backend Phases 4-6 not built yet)
# false  = every call goes to the FastAPI backend (use once Phases 4-6 exist)
VITE_USE_MOCK=true
